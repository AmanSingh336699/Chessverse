# ==============================================================================
# Chessverse - Root Environment Configuration Example
# Copy this file or individual app env files to configure your environment.
# ==============================================================================

# --- API Configuration (apps/api) ---------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Stockfish Engine
# STOCKFISH_PATH=
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=32

# Opening Book & Syzygy
# OPENING_BOOK_PATH=
# SYZYGY_PATH=

# Worker Pool
WORKER_POOL_SIZE=1
ENGINE_TIMEOUT_MS=10000
WORKER_QUEUE_TIMEOUT_MS=8000
MAX_QUEUE_DEPTH=20
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=5000
MAX_WORKER_CRASHES=3
WORKER_CRASH_WINDOW_MS=60000

# Client-Side Analysis
CLIENT_ANALYSIS_ENABLED=true

# Database & Redis (Optional - In-Memory Fallbacks available)
# DATABASE_URL=postgresql://user:password@localhost:5432/chessverse
# REDIS_URL=redis://localhost:6379

# Context Store
CONTEXT_REDIS_TTL_SECONDS=86400
CONTEXT_LOCK_TIMEOUT_MS=5000
CONTEXT_LOCK_ACQUIRE_MS=500

# Move Classification Thresholds
CLASSIFICATION_BEST_MAX=0.2
CLASSIFICATION_EXCELLENT_MAX=0.5
CLASSIFICATION_GOOD_MAX=1.0
CLASSIFICATION_INACCURACY_MAX=2.0
CLASSIFICATION_MISTAKE_MAX=4.0

# Analysis Cache
ANALYSIS_CACHE_TTL_SECONDS=86400

# --- Web Frontend Configuration (apps/web) ------------------------------------
VITE_API_BASE_URL=http://localhost:3001
